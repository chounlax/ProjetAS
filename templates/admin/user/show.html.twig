{% extends 'base.html.twig' %}

{% block title %}{{ user.nomComplet }} · Administration{% endblock %}

{% block body %}
<section class="container admin-page">
    <p class="breadcrumb"><a href="{{ path('admin_user_index') }}">← Utilisateurs</a></p>

    <div class="card profile-header">
        <div class="avatar">{{ user.initiales }}</div>
        <div>
            <h1>{{ user.nomComplet }}</h1>
            <p>
                {{ user.email }} ·
                {{ user.admin ? 'Administrateur' : 'Utilisateur' }} ·
                {% if user.active %}<span class="status status-active">Actif</span>{% else %}<span class="status status-suspended">Suspendu</span>{% endif %}
            </p>
        </div>
        <div class="profile-actions">
            <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="btn btn-outline">Modifier</a>
        </div>
    </div>

    <div class="profile-grid">
        <div class="card profile-section">
            <h2>Coordonnées</h2>
            <dl class="info-list">
                <div class="info-item"><dt>Adresse</dt><dd>{{ user.adresse }}</dd></div>
                <div class="info-item"><dt>Code postal</dt><dd>{{ user.codePostal }}</dd></div>
                <div class="info-item"><dt>Ville</dt><dd>{{ user.ville }}</dd></div>
                {% if user.createdAt %}
                    <div class="info-item"><dt>Inscrit le</dt><dd>{{ user.createdAt|date('d/m/Y à H:i', 'Europe/Paris') }}</dd></div>
                {% endif %}
            </dl>
        </div>
    </div>

    <div class="card table-card history-card">
        <h2>Historique des connexions</h2>
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Heure</th>
                    <th>Résultat</th>
                    <th>Adresse IP</th>
                    <th>Navigateur</th>
                </tr>
            </thead>
            <tbody>
                {% for login in user.loginHistories %}
                    <tr>
                        <td>{{ login.connectedAt|date('d/m/Y', 'Europe/Paris') }}</td>
                        <td>{{ login.connectedAt|date('H:i:s', 'Europe/Paris') }}</td>
                        <td>
                            {% if login.success %}
                                <span class="status status-active">Réussie</span>
                            {% else %}
                                <span class="status status-suspended">Échouée</span>
                            {% endif %}
                        </td>
                        <td>{{ login.ipAddress ?? '—' }}</td>
                        <td class="muted small" title="{{ login.userAgent }}">{{ login.userAgent|default('—')|slice(0, 60) }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="5">Aucune connexion enregistrée.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% endblock %}
