{% extends 'base.html.twig' %}

{% block title %}Utilisateurs · Administration{% endblock %}

{% block body %}
<section class="container admin-page">
    <div class="admin-head">
        <div>
            <h1>Utilisateurs</h1>
            <p class="subtitle">{{ users|length }} compte{{ users|length > 1 ? 's' }}</p>
        </div>
        <a href="{{ path('admin_user_new') }}" class="btn btn-primary">Ajouter un utilisateur</a>
    </div>

    <div class="card table-card">
        <table class="table">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>E-mail</th>
                    <th>Rôle</th>
                    <th>Statut</th>
                    <th>Dernière connexion</th>
                    <th class="actions-col">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    {% set last = user.lastLogin %}
                    <tr>
                        <td><a href="{{ path('admin_user_show', {id: user.id}) }}" class="strong-link">{{ user.nomComplet }}</a></td>
                        <td>{{ user.email }}</td>
                        <td>
                            {% if user.admin %}
                                <span class="badge-role badge-admin">Administrateur</span>
                            {% else %}
                                <span class="badge-role">Utilisateur</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if user.active %}
                                <span class="status status-active">Actif</span>
                            {% else %}
                                <span class="status status-suspended">Suspendu</span>
                            {% endif %}
                        </td>
                        <td>{{ last ? last.connectedAt|date('d/m/Y à H:i', 'Europe/Paris') : 'Jamais' }}</td>
                        <td class="actions-col">
                            <div class="row-actions">
                                <a href="{{ path('admin_user_show', {id: user.id}) }}" class="btn btn-small btn-outline">Historique</a>
                                <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="btn btn-small btn-outline">Modifier</a>
                                {% if user != app.user %}
                                    <form method="post" action="{{ path('admin_user_toggle', {id: user.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ user.id) }}">
                                        <button class="btn btn-small btn-outline">{{ user.active ? 'Suspendre' : 'Réactiver' }}</button>
                                    </form>
                                    <form method="post" action="{{ path('admin_user_delete', {id: user.id}) }}" onsubmit="return confirm('Supprimer définitivement ce compte ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                        <button class="btn btn-small btn-danger">Supprimer</button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6">Aucun utilisateur.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% endblock %}
