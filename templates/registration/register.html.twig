{% extends 'base.html.twig' %}

{% block title %}Inscription · ProjetAS{% endblock %}

{% macro field(field, label, placeholder) %}
    <div class="form-group">
        {{ form_label(field, label) }}
        {{ form_widget(field, {attr: {placeholder: placeholder}}) }}
        <div class="form-error">{{ form_errors(field) }}</div>
    </div>
{% endmacro %}

{% block body %}
{% import _self as f %}
<section class="auth-page">
    <div class="card auth-card wide">
        <h1>Créer un compte</h1>
        <p class="subtitle">Quelques informations et c'est parti.</p>

        {{ form_start(registrationForm) }}
            {% if not registrationForm.vars.valid and form_errors(registrationForm) is not empty %}
                <div class="alert">{{ form_errors(registrationForm) }}</div>
            {% endif %}

            <div class="form-row">
                {{ f.field(registrationForm.prenom, 'Prénom', 'Jean') }}
                {{ f.field(registrationForm.nom, 'Nom', 'Dupont') }}
            </div>

            {{ f.field(registrationForm.email, 'Adresse e-mail', 'vous@exemple.fr') }}

            {{ f.field(registrationForm.adresse, 'Adresse', '12 rue de la Paix') }}

            <div class="form-row zip">
                {{ f.field(registrationForm.codePostal, 'Code postal', '75001') }}
                {{ f.field(registrationForm.ville, 'Ville', 'Paris') }}
            </div>

            <div class="form-row">
                {{ f.field(registrationForm.plainPassword.first, 'Mot de passe', '12 caractères minimum') }}
                {{ f.field(registrationForm.plainPassword.second, 'Confirmer le mot de passe', 'Retapez-le') }}
            </div>
            <div class="form-error">{{ form_errors(registrationForm.plainPassword) }}</div>

            {% include 'partials/_password_rules.html.twig' %}

            <div class="form-check">
                {{ form_widget(registrationForm.agreeTerms) }}
                {{ form_label(registrationForm.agreeTerms, "J'accepte les conditions d'utilisation") }}
            </div>
            <div class="form-error terms-error">{{ form_errors(registrationForm.agreeTerms) }}</div>

            <button type="submit" class="btn btn-primary btn-block">Créer mon compte</button>
        {{ form_end(registrationForm) }}

        <p class="auth-footer">
            Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a>
        </p>
    </div>
</section>
{% endblock %}
