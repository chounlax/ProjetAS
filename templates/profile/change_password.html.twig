{% extends 'base.html.twig' %}

{% block title %}Changer le mot de passe · ProjetAS{% endblock %}

{% macro field(field, label) %}
    <div class="form-group">
        {{ form_label(field, label) }}
        {{ form_widget(field) }}
        <div class="form-error">{{ form_errors(field) }}</div>
    </div>
{% endmacro %}

{% block body %}
{% import _self as f %}
<section class="auth-page">
    <div class="card auth-card">
        <h1>Changer le mot de passe</h1>
        <p class="subtitle">Votre nouveau mot de passe ne peut pas être un mot de passe déjà utilisé.</p>

        {{ form_start(form) }}
            {{ f.field(form.currentPassword, 'Mot de passe actuel') }}
            {{ f.field(form.newPassword.first, 'Nouveau mot de passe') }}
            {{ f.field(form.newPassword.second, 'Confirmer le nouveau mot de passe') }}
            <div class="form-error">{{ form_errors(form.newPassword) }}</div>

            {% include 'partials/_password_rules.html.twig' %}

            <button type="submit" class="btn btn-primary btn-block">Enregistrer</button>
        {{ form_end(form) }}

        <p class="auth-footer"><a href="{{ path('app_profile') }}">Retour au profil</a></p>
    </div>
</section>
{% endblock %}
